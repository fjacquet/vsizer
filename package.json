{
  "name": "vsizer",
  "private": true,
  "version": "1.8.1",
  "type": "module",
  "description": "Drop your RVTools / Live Optics export, get a factual cluster utilization deck. 100% client-side.",
  "bin": {
    "vsizer-pptx": "src/cli/pptx.ts"
  },
  "scripts": {
    "pptx": "tsx src/cli/pptx.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:container": "tsc -b && vite build --base=/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate-sample": "node scripts/generate-sample.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-i18next": "^17.0.12",
    "sonner": "^2.0.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2",
    "workbox-build": "^7.4.1",
    "tsx": "^4.23.12",
    "workbox-window": "^7.4.1"
  }
}
